# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - API GEO BACKEND (.env.example)
# Padrão: Execução Localhost (desenvolvimento da equipe)
# ==============================================================================

# Porta do Servidor
PORT=8080
SERVER_PORT=8080

# Banco de Dados PostgreSQL / PostGIS Local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_geo
DB_USER=root
DB_PASSWORD=root

# Hibernate / JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true

# Upload de Arquivos Geoespaciais
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5GB

# Prefixo dos Endpoints da API
SPRING_MVC_SERVLET_PATH=/api

