# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - API GEO BACKEND (.env)
# ==============================================================================
# Este arquivo é lido automaticamente pelo executável da API Geo ao iniciar.
# Você pode duplicar este arquivo como .env e ajustar os valores conforme o ambiente.
# ==============================================================================

# Porta da aplicação
PORT=8080
# Ou:
# SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL / PostGIS
# ------------------------------------------------------------------------------
# Configuração simplificada (monta a JDBC URL automaticamente):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_geo
DB_USER=root
DB_PASSWORD=root

# Ou especifique a URL JDBC completa se preferir:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sistema_geo
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root

# ------------------------------------------------------------------------------
# Hibernate / JPA
# ------------------------------------------------------------------------------
# ddl-auto: validate (padrão), update, create-drop, none
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# Flyway Migrations
# ------------------------------------------------------------------------------
SPRING_FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# Upload de Arquivos Geoespaciais
# ------------------------------------------------------------------------------
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=5GB
SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=2MB

# ------------------------------------------------------------------------------
# Prefixo dos Endpoints da API
# ------------------------------------------------------------------------------
SPRING_MVC_SERVLET_PATH=/api

# ------------------------------------------------------------------------------
# Fontes de Cruzamento do Cálculo Analítico
# ------------------------------------------------------------------------------
CALCULO_ANALITICO_FONTES_APP=INCAR_APP
CALCULO_ANALITICO_FONTES_RESERVA_LEGAL=INCAR_RESERVA_LEGAL,ICMBIO_UC_FEDERAL,SFB_FLORESTA_PUBLICA,MMA_UC_CNUC
CALCULO_ANALITICO_FONTES_ALERTAS=INPE_DESMATAMENTO_MATA_ATLANTICA,INPE_DESMATAMENTO_CERRADO,IBAMA_EMBARGO,FUNAI_TERRA_INDIGENA,INCRA_QUILOMBOLA,INCRA_ASSENTAMENTO,INPE_QUEIMADA
